rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validMessage() {
      return signedIn()
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 32
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time;
    }

    function validProfile(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.authorName
          == get(/databases/$(database)/documents/users/$(uid)).data.username;
    }

    function isConversationParticipant(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/directMessages/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(conversationId)).data.participants;
    }

    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 1
        && request.resource.data.username.size() <= 32;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 1
        && request.resource.data.username.size() <= 32;
      allow delete: if false;
    }

    match /communities/{communityId}/channels/{channelId}/messages/{messageId} {
      allow read: if signedIn();
      allow create: if validMessage() && validProfile(request.auth.uid);
      allow update, delete: if false;
    }

    match /directMessages/{conversationId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participants', 'updatedAt'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.keys().hasOnly(['participants', 'updatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);
        allow create: if validMessage()
          && validProfile(request.auth.uid)
          && isConversationParticipant(conversationId);
        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'reporterId', 'reportedUserId', 'messageId', 'channel', 'reason', 'createdAt'
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.messageId is string
        && request.resource.data.channel is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500;
      allow read, update, delete: if false;
    }
  }
}
